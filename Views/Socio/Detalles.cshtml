@model libranet.Models.Socio
@{
    ViewData["Title"] = "Detalles del Socio";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div>
    <h4>Información Personal</h4>
    <dl class="row">
        <dt class="col-sm-3">Apellido</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Apellido)</dd>

        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

        <dt class="col-sm-3">DNI</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.DNI)</dd>

        <dt class="col-sm-3">Número de Socio</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.NumeroSocio)</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>
    </dl>
</div>

<hr />

<div>
    <h4>Historial de Préstamos</h4>
    @if (Model.Prestamos != null && Model.Prestamos.Any())
    {
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th>Libro</th>
                    <th>Fecha de Préstamo</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prestamo in Model.Prestamos)
                {
                    <tr>
                        <td>@prestamo.Libro!.Titulo</td>
                        <td>@prestamo.FechaPrestamo.ToShortDateString()</td>
                        <td>
                            @if (prestamo.FechaDevolucionReal == null)
                            {
                                <span class="badge bg-warning text-dark">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Devuelto</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>Este socio no tiene préstamos registrados.</p>
    }
</div>

<div class="mt-3">
    <a asp-action="Editar" asp-route-id="@Model.SocioId" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
</div>