@model libranet.Models.PrestamoViewModel
@{
    ViewData["Title"] = "Registrar Nuevo Préstamo";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Crear" method="post">

            <div class="mb-3">
                <label for="socio-search" class="form-label">Buscar Socio (por Número de Socio o DNI)</label>
                <input type="text" id="socio-search" class="form-control" placeholder="Empieza a escribir para buscar...">
                <input type="hidden" name="socioId" id="socioId">
            </div>

            <div class="mb-3">
                <label for="libro-search" class="form-label">Buscar Libro (por Título, Autor o ISBN)</label>
                <input type="text" id="libro-search" class="form-control" placeholder="Empieza a escribir para buscar...">
                <input type="hidden" name="libroId" id="libroId">
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Registrar Préstamo</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // --- Autocompletado para Socios ---
            $("#socio-search").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "@Url.Action("Buscar", "Socio")",
                        dataType: "json",
                        data: {
                            term: request.term
                        },
                        success: function (data) {
                            response(data);
                        }
                    });
                },
                minLength: 2, // Empezar a buscar después de 2 caracteres
                select: function (event, ui) {
                    // Cuando se selecciona un socio de la lista...
                    // Guardamos el texto visible en el campo de búsqueda
                    $("#socio-search").val(ui.item.label);
                    // Guardamos el ID en el campo oculto
                    $("#socioId").val(ui.item.id);
                    return false;
                }
            });

            // --- Autocompletado para Libros ---
            $("#libro-search").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "@Url.Action("Buscar", "Libro")",
                        dataType: "json",
                        data: {
                            term: request.term
                        },
                        success: function (data) {
                            response(data);
                        }
                    });
                },
                minLength: 2,
                select: function (event, ui) {
                    $("#libro-search").val(ui.item.label);
                    $("#libroId").val(ui.item.id);
                    return false;
                }
            });
        });
    </script>
}