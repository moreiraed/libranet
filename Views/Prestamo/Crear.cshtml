@model libranet.Models.PrestamoViewModel
@{
    ViewData["Title"] = "Registrar Nuevo Préstamo";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Crear">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label">Socio</label>
                <select name="socioId" class="form-control" asp-items="@Model.Socios">
                    <option value="">-- Seleccione un Socio --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Libro Disponible</label>
                <select name="libroId" class="form-control" asp-items="@Model.LibrosDisponibles">
                    <option value="">-- Seleccione un Libro --</option>
                </select>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Registrar Préstamo</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>