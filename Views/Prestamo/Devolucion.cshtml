@model libranet.Models.Prestamo
@{
    ViewData["Title"] = "Registrar Devolución";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div>
    <h4>Detalles del Préstamo</h4>
    <dl class="row">
        <dt class="col-sm-3">Libro</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Libro!.Titulo)</dd>

        <dt class="col-sm-3">Socio</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Socio!.Apellido), @Html.DisplayFor(model => model.Socio!.Nombre)</dd>
    </dl>

    <form asp-action="Devolucion">
        <input type="hidden" asp-for="PrestamoId" />

        @* --- NUEVO CAMPO --- *@
        @* Este es un checkbox para indicar si el libro está dañado. *@
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="estaDanado" value="true" id="estaDanado">
            <label class="form-check-label text-danger" for="estaDanado">
                Marcar si el libro fue devuelto con daños
            </label>
        </div>

        <button type="submit" class="btn btn-success">Confirmar Devolución</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>